{
  "manifest_version": 3,
  "name": "X Unfollow",
  "version": "1.1.0",
  "description": "Find and unfollow inactive X accounts. No paid API required.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "X Unfollow"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": ["storage", "tabs", "scripting", "sidePanel", "alarms", "unlimitedStorage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ]
}
